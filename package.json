{
  "name": "codex-flow",
  "version": "0.1.0",
  "description": "YAML-driven workflow engine for multi-step development tasks powered by Codex",
  "type": "module",
  "bin": {
    "codex-flow": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "codex",
    "openai",
    "workflow",
    "automation",
    "cli",
    "devops",
    "agent"
